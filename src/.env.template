# ============================================================
# Environment Configuration Template
# ============================================================
#
# This file defines the environment variables required to run
# the Discogs → SQL Server ETL pipeline.
#
# HOW TO USE:
# 1. Copy this file and rename it to `.env`
#      cp .env.template .env
# 2. Fill in the values below with your own credentials.
# 3. Do NOT commit `.env` to version control.
#    (It is intentionally ignored via .gitignore.)
#
# The Python ETL script automatically loads variables from
# `.env` at runtime using python-dotenv.
#
# ============================================================


# ------------------------------------------------------------
# Discogs API Configuration
# ------------------------------------------------------------
# Create a personal access token in Discogs and paste it here.
DISCOGS_TOKEN=

# Discogs requires a descriptive User-Agent string.
# Include a project name and a URL or contact reference.
#
# Example:
# DiscogsETL/1.0 +https://www.discogs.com/user/yourusername
DISCOGS_USER_AGENT=

# Your Discogs username (as it appears in your profile URL)
DISCOGS_USERNAME=


# ------------------------------------------------------------
# SQL Server Configuration (Windows Authentication)
# ------------------------------------------------------------
# SQL Server instance name
#
# Example:
# localhost\SQLEXPRESS
SQL_SERVER=

# Target database name
#
# Example:
# Discogs
SQL_DATABASE=

# Installed ODBC driver name (must match your system)
#
# Example:
# ODBC Driver 18 for SQL Server
SQL_DRIVER=
